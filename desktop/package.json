{
  "name": "tcg-business-manager",
  "productName": "TCG Business Manager",
  "version": "5.2.0",
  "private": true,
  "description": "Offline-Warenwirtschaft und Market-Intelligence-Grundlage für den europäischen TCG-Handel.",
  "main": "app/main/main.js",
  "author": "Stefan",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node --check app/main/main.js && node --check app/main/database.js && node --check app/main/preload.js && node --check app/main/cardmarket-api-adapter.js && node --check app/shared/card-search.js && node --check app/shared/business-automation.js && node --check app/renderer/app.js && node --check app/renderer/cardmarket-data-center.js",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && electron --version",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "build": {
    "appId": "de.stefan.tcg.businessmanager",
    "productName": "TCG Business Manager",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "database/**/*",
      "resources/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TCG Business Manager",
      "deleteAppDataOnUninstall": false
    }
  }
}
