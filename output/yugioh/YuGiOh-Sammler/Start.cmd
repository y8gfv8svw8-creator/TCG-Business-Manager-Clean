@echo off
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$nodePath = (Get-Command node.exe -ErrorAction SilentlyContinue).Source; if (-not $nodePath) { Write-Host 'Node.js wurde nicht gefunden. Bitte Node.js installieren.'; Read-Host 'Enter'; exit 1 }; $ready = $false; try { $health = Invoke-RestMethod 'http://127.0.0.1:8767/health' -TimeoutSec 2; if ($health.app -eq 'yugioh-sammler') { $ready = $true } else { throw 'Port wird von einer anderen Anwendung verwendet.' } } catch {}; if (-not $ready) { Start-Process -FilePath $nodePath -ArgumentList 'server.cjs' -WorkingDirectory (Get-Location).Path -WindowStyle Hidden; for ($attempt = 0; $attempt -lt 20; $attempt++) { Start-Sleep -Milliseconds 250; try { $health = Invoke-RestMethod 'http://127.0.0.1:8767/health' -TimeoutSec 1; if ($health.app -eq 'yugioh-sammler') { $ready = $true; break } } catch {} } }; if ($ready) { Start-Process 'http://127.0.0.1:8767' } else { Write-Host 'Start fehlgeschlagen. Siehe start-fehler.txt oder Port 8767 pruefen.'; Read-Host 'Enter' }"
